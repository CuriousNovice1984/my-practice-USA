# Django
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=GENERATE_A_KEY_AND_PUT_IT_HERE  # CHANGE ME
# Fernet key for encrypting clinical fields (Art. 9 DSGVO data).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED for P-009 clinical models. Keep this key safe — loss means clinical data is unrecoverable.
FERNET_KEY=GENERATE_A_KEY_AND_PUT_IT_HERE  # CHANGE ME
# Dev setup only — do not set to False in docker-compose.yml; use docker-compose.prod.yml for production.
DJANGO_DEBUG=True
# Comma-separated list of allowed hosts, or "*" for dev only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional — override the default time zone (US Central).
# DJANGO_TIME_ZONE=America/Chicago
# Only takes effect when DJANGO_DEBUG=False. Set to "true" if this instance is reachable
# over HTTPS (e.g. behind a TLS-terminating reverse proxy) — enables HTTPS redirect, secure
# cookies, and HSTS. Leave "false" for a plain-HTTP LAN/local deployment.
SECURE_SSL_REDIRECT=false

# PostgreSQL database
POSTGRES_DB=my_practice
POSTGRES_USER=my_practice
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD  # CHANGE ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Email Configuration (Proton Bridge)
# Set to "true" to enable SMTP via Proton Bridge
USE_PROTON_BRIDGE=false
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=your-email@proton.me  # CHANGE ME
EMAIL_HOST_PASSWORD=your-proton-bridge-password  # CHANGE ME
DEFAULT_FROM_EMAIL=your-email@proton.me  # CHANGE ME

# Google Calendar API (Optional - for calendar import proof of concept)
# Create OAuth2 credentials at: https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:8000/calendar/oauth2callback/
# Add yourself as test user in OAuth consent screen
GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com  # CHANGE ME
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-your-client-secret  # CHANGE ME

# External data directory — MUST be outside the git repository.
# Contains: backups/ and media/ subdirectories.
# Default (if unset): ../my-practice-data  (sibling of the repo clone)
# Recommended: set an absolute path specific to this machine, e.g.
#   MY_PRACTICE_DATA_DIR=/home/youruser/data/my-practice
MY_PRACTICE_DATA_DIR=/path/to/your/my-practice-data  # CHANGE ME


# Plaid bank connection (optional) — imports transactions straight from your bank
# on /bank/plaid/. Create keys at dashboard.plaid.com; start with sandbox keys
# (test bank login user_good / pass_good), then switch to production.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# Client forms portal — public origin clients reach /portal/ links on, e.g. a
# Tailscale Funnel port (see docs/operations/CLIENT_PORTAL.md). Trusted for CSRF
# automatically. Leave unset to build links from the current host.
# PORTAL_BASE_URL=https://practice-box.your-tailnet.ts.net:8443
# PORTAL_LINK_DAYS=14
# Extra origins allowed to POST forms (comma-separated), if any
# DJANGO_CSRF_TRUSTED_ORIGINS=
